# HTTP server port
PORT=3000

# Supabase Auth + PostgreSQL (use the Supabase direct/session pooler URL)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DATABASE_SSL=true
DATABASE_POOL_SIZE=10
ADMIN_EMAIL=
FREE_MONTHLY_TOKENS=50000

# Real LLM quota metering. Reservations prevent concurrent requests from
# overspending the same balance. The cron is backed up by a lazy monthly reset.
ENFORCE_LLM_QUOTA=true
LLM_MAX_OUTPUT_TOKENS=12000
LLM_TOKEN_ESTIMATE_CHARS=3
# Set these to the prices of the selected model; do not hard-code model prices.
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
LLM_CACHE_READ_COST_PER_MILLION=0
LLM_CACHE_WRITE_COST_PER_MILLION=0
QUOTA_CRON_ENABLED=true
QUOTA_CRON_SCHEDULE=0 0 1 * *
QUOTA_CRON_TIMEZONE=Europe/Istanbul

# Generated files and persistent user/account data
OUTPUT_DIR=output
DATA_DIR=data
CORS_ORIGIN=*

# Validated prompt cache. Keep "observe" until hit quality has been reviewed.
# off = disabled, observe = LLM still runs, read = validated private hit skips LLM.
PROMPT_CACHE_MODE=observe
PROMPT_CACHE_DIR=data/prompt-cache
PROMPT_PIPELINE_VERSION=1
# Set this to the FreeCAD release used by the remote drawing PC (for example 0.21.2).
FREECAD_COMPATIBILITY_VERSION=unspecified

# Private user/project/version storage on the remote FreeCAD PC.
PROJECT_ARCHIVE_ENABLED=true
PROJECT_ARCHIVE_DIR=data/user-storage

# How to launch the FreeCAD MCP server as a local stdio subprocess
FREECAD_MCP_COMMAND=uvx
FREECAD_MCP_ARGS=freecad-mcp
FREECAD_MCP_TOOL_NAME=execute_code
FREECAD_MCP_TOOL_PARAM=code
FREECAD_MCP_CALL_TIMEOUT_MS=90000

# --- LLM Provider ---
# "openai" or "claude"
LLM_PROVIDER=claude

# --- Claude Code CLI ---
CLAUDE_CLI_COMMAND=claude
CLAUDE_CLI_MODEL=
CLAUDE_CLI_TIMEOUT_MS=180000

# --- OpenAI API ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=180000

# Payment provider credentials will be added after provider selection.
