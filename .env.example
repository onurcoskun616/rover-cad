# HTTP server port
PORT=3000

# Shared secret required in the "x-api-key" header for POST /generate.
# /health is intentionally left open (no key needed). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=

# Generated STEP/STL files are written here (relative to project root, or absolute path)
OUTPUT_DIR=output

# How to launch the FreeCAD MCP server as a local stdio subprocess
FREECAD_MCP_COMMAND=uvx
FREECAD_MCP_ARGS=freecad-mcp

# MCP tool used to run the generated Python code inside FreeCAD, and the
# argument name that tool expects for the code payload. Adjust these if your
# FreeCAD MCP server exposes a differently named tool/parameter.
FREECAD_MCP_TOOL_NAME=execute_code
FREECAD_MCP_TOOL_PARAM=code
# Max time to wait for a single FreeCAD MCP tool call (e.g. execute_code or
# the export step) before giving up and reconnecting. Without this, a stuck
# or invalid FreeCAD operation (e.g. a hanging boolean operation) can hang
# the request forever with no error.
FREECAD_MCP_CALL_TIMEOUT_MS=90000

# Claude Code CLI, used to translate the incoming natural-language prompt
# into FreeCAD Python code. Requires `claude` to already be installed and
# logged in on this machine (no separate API key needed).
CLAUDE_CLI_COMMAND=claude
# Optional model override (alias like "sonnet"/"opus" or a full model name).
# Leave empty to use the CLI's own default. Tip: image->CAD (the /generate-from-image
# flow) is more reliable on a stronger model (e.g. "opus").
CLAUDE_CLI_MODEL=
CLAUDE_CLI_TIMEOUT_MS=120000
